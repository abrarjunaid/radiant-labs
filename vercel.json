{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/process", "destination": "/services#process", "permanent": true },
    { "source": "/process.html", "destination": "/services#process", "permanent": true }
  ],
  "headers": [
    {
      "source": "/textures/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
